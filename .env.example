# ── Mother OS Environment Variables ──────────────────────────────────────────
# Copy to .env and fill in real values. Never commit .env.

# Database (local SQLite via libSQL)
# StackBlitz: use file: path relative to project root
DATABASE_URL="file:./data/mother.db"

# Anthropic
ANTHROPIC_API_KEY="sk-ant-..."

# Google (Gmail + Calendar) — GCP OAuth Desktop client
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4789/api/auth/google/callback"

# Google Maps (gig travel time — Phase 3)
GOOGLE_MAPS_API_KEY=""

# GoCardless Bank Account Data (Phase 6)
GOCARDLESS_SECRET_ID=""
GOCARDLESS_SECRET_KEY=""

# Last.fm (music — Phase 4)
LASTFM_API_KEY=""
LASTFM_USERNAME="pete_smith"

# Pushover (optional phone notifications)
PUSHOVER_TOKEN=""
PUSHOVER_USER=""

# Encryption key for OAuth tokens stored in SQLite
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=""

# Daily LLM token budget cap
MAX_TOKENS_PER_DAY=2000000
